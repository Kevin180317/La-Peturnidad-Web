---
import "../../styles/global.css";

import "@fontsource/pretendard/400.css";
import "@fontsource/pretendard/500.css";
import "@fontsource/pretendard/600.css";
import "@fontsource/pretendard/700.css";

import LoginForm from "../../components/admin/LoginForm";

// src/middleware.ts lets this route through without a session, so it must be
// server rendered like the rest of the panel rather than prerendered.
export const prerender = false;

// Only same-origin admin paths are accepted, to keep ?next= from turning into
// an open redirect.
const requested = Astro.url.searchParams.get("next") ?? "/admin";
const nextPath = requested.startsWith("/admin") ? requested : "/admin";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="shortcut icon" href="/favicon_16x16.png" />
    <title>Acceso · Panel Lucky Tracker</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-fondo via-white to-fondo px-4 text-texto">
    <div class="w-full max-w-md">
      <div class="rounded-2xl bg-white shadow-lg shadow-principal/10 border border-texto/5 p-8 sm:p-10">
        <div class="mb-8 text-center">
          <h1 class="text-2xl font-bold tracking-tight">Lucky Tracker</h1>
          <p class="mt-2 text-sm text-texto/60">
            Panel de administración
          </p>
        </div>

        <div class="mb-8 space-y-1 text-center">
          <p class="text-xs font-semibold uppercase tracking-wide text-texto/40">
            Acceso exclusivo para administradores
          </p>
        </div>

        <LoginForm nextPath={nextPath} client:load />

        <div class="mt-8 pt-6 border-t border-texto/10">
          <p class="text-center text-xs text-texto/50">
            Panel seguro con autenticación de dos factores
          </p>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-texto/40">
        © 2025 Lucky Tracker. Sistema administrativo.
      </p>
    </div>
  </body>
</html>
