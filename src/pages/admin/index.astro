---
import AdminShell from "../../components/admin/AdminShell.astro";
import Dashboard from "../../components/admin/Dashboard";
import { ADMIN_SECTIONS } from "../../lib/admin/sections";
import {
  countPendingReports,
  getAdminStats,
  getAdminTrends,
} from "../../lib/admin/queries";
import { resolveTrendRange } from "../../lib/admin/trend";
import { iconSvg } from "../../lib/admin/icons";

export const prerender = false;

// Read during SSR so the page paints with numbers and a drawn chart instead of
// a skeleton, and so the window in the URL is the window that gets rendered.
// Safe to read directly here because src/middleware.ts has already verified the
// session before this renders.
const range = resolveTrendRange(Astro.url.searchParams.get("range"));

let initialStats: Record<string, number> | undefined;
let initialTrends: Awaited<ReturnType<typeof getAdminTrends>> | undefined;

// Counts, the trend read and the moderation queue depth are independent, so a
// failure in one still leaves a usable page: the KPI grid falls back to its own
// fetch, or the chart shows a retryable error.
const [stats, trends, pending] = await Promise.allSettled([
  getAdminStats(),
  getAdminTrends(range),
  countPendingReports(),
]);

if (stats.status === "fulfilled") initialStats = stats.value;
if (trends.status === "fulfilled") initialTrends = trends.value;

// Left undefined on failure so the client retries it; the banner hides itself
// while the number is unknown instead of claiming an empty queue.
const initialPending = pending.status === "fulfilled" ? pending.value : undefined;

if (stats.status === "rejected") {
  console.error("Admin index: could not read summary counts:", stats.reason);
}
if (trends.status === "rejected") {
  console.error("Admin index: could not read activity trends:", trends.reason);
}
if (pending.status === "rejected") {
  console.error("Admin index: could not read pending reports:", pending.reason);
}
---

<AdminShell title="Resumen" active="resumen">
  <div class="space-y-8">
    <div class="flex flex-col gap-1">
      <h1 class="text-2xl font-bold tracking-tight text-texto">Resumen</h1>
      <p class="mt-1 text-sm text-texto/60">
        Métricas de Lucky Tracker, leídas de la base de datos de la app.
      </p>
    </div>

    <Dashboard
      initialStats={initialStats}
      initialTrends={initialTrends}
      initialRange={range}
      initialPending={initialPending}
      client:load
    />

    <section class="rounded-2xl border border-texto/5 bg-panel">
      <details class="group">
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-texto"
        >
          <span class="flex items-center gap-2.5">
            <span
              class="text-texto/40 transition-transform group-open:rotate-180"
              set:html={iconSvg("chevronDown", "h-4 w-4")}
            />
            Nota sobre los conteos
          </span>
          <span class="text-xs font-normal text-texto/40 sm:hidden">
            {initialPending && initialPending > 0
              ? `${initialPending} por revisar`
              : ""}
          </span>
        </summary>
        <ul
          class="list-disc space-y-2 border-t border-texto/5 px-5 py-4 pl-9 text-sm text-texto/60"
        >
          <li>
            <strong class="text-texto/80">Alertas de pérdida</strong> es un acumulado
            histórico: la app borra el registro cuando la mascota aparece, así que
            no son emergencias abiertas.
          </li>
          <li>
            <strong class="text-texto/80">Historias</strong> solo cuenta las
            reuniones que los usuarios publican a mano, por lo que queda por debajo
            de las reuniones reales.
          </li>
          <li>
            <strong class="text-texto/80">Mensajes y conversaciones</strong> no
            están en el panel a propósito: no se da acceso al chat privado de los
            usuarios.
          </li>
          <li>
            <strong class="text-texto/80">El gráfico</strong> cuenta filas nuevas
            por día. No coincide con los totales de las tarjetas, que son conteos
            exactos sobre toda la tabla.
          </li>
        </ul>
      </details>
    </section>

    <section>
      <h2 class="mb-3 text-sm font-semibold text-texto">Secciones</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          ADMIN_SECTIONS.map((section) => (
            <a
              href={`/admin/${section.slug}`}
              class="group flex items-start gap-3 rounded-xl border border-texto/5 bg-panel p-4 transition-all hover:-translate-y-0.5 hover:border-principal/30 hover:shadow-md"
            >
              <span
                class="text-texto/40 transition-colors group-hover:text-principal"
                set:html={iconSvg(section.icon ?? "file", "h-5 w-5")}
              />
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-texto">
                  {section.title}
                </span>
                <span class="mt-0.5 block text-xs leading-relaxed text-texto/50">
                  {section.description}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</AdminShell>