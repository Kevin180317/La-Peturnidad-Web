---
import "../styles/global.css";

import "@fontsource/pretendard/400.css";
import "@fontsource/pretendard/500.css";
import "@fontsource/pretendard/600.css";
import "@fontsource/pretendard/700.css";
import HeaderAndChat from "../components/HeaderAndChat.jsx";
import Footer from "../components/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const { footer = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="shortcut icon" href="/favicon_16x16.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Lucky Tracker - Encuentra Mascotas Perdidas en tu Comunidad</title>
    <meta
      name="description"
      content="Conecta con tu comunidad y reporta mascotas perdidas o encontradas. Únete a Lucky Tracker y ayuda a reunir familias con sus peludos."
    />
    <meta
      name="keywords"
      content="Mascotas Perdidas, Comunidad, Reporte de Mascotas, Reunión de Mascotas, Lucky Tracker, Ayuda a Mascotas, Encuentra Mascotas, Reporta Mascotas, Mascotas Encontradas"
    />
    <link rel="canonical" href="https://luckytracker.com.mx/" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Prometheus R&D" />
    <meta name="publisher" content="Prometheus R&D" />

    <meta property="og:url" content="https://luckytracker.com.mx/" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Lucky Tracker - Encuentra Mascotas Perdidas en tu Comunidad"
    />
    <meta
      property="og:description"
      content="Conecta con tu comunidad y reporta mascotas perdidas o encontradas. Únete a Lucky Tracker y ayuda a reunir familias con sus peludos."
    />
    <meta
      property="og:image"
      content="https://luckytracker.com.mx/OpenGraphLogo.png"
    />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Lucky Tracker",
        "url": "https://luckytracker.com.mx/",
        "logo": "https://luckytracker.com.mx/Imagotipo_colore_original.png",
        "description": "Conecta con tu comunidad y reporta mascotas perdidas o encontradas. Únete a Lucky Tracker y ayuda a reunir familias con sus peludos.",
        "founder": "Prometheus R&D",
        "sameAs": [
          "https://www.facebook.com/petnowofficial",
          "https://www.instagram.com/petnow_official/"
        ]
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Lucky Tracker",
        "url": "https://luckytracker.com.mx/",
        "description": "Encuentra Mascotas Perdidas en tu Comunidad",
        "publisher": {
          "@type": "Organization",
          "name": "Prometheus R&D"
        }
      }
    </script>
  </head>
  <body class="overflow-x-hidden relative bg-fondo">
    <HeaderAndChat lang={lang} client:visible />
    <slot />
    {footer ? <Footer /> : <slot name="footer" />}
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
  }
</style>
