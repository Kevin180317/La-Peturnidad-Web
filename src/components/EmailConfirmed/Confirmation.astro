---
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="relative flex h-screen items-center justify-center px-6 pt-32 pb-20 overflow-hidden"
>
  <div
    class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-principal/15 blur-3xl"
  ></div>
  <div
    class="absolute -bottom-32 -right-24 w-[28rem] h-[28rem] rounded-full bg-secundario/20 blur-3xl"
  ></div>
  <div
    class="absolute top-1/2 left-1/3 w-72 h-72 rounded-full bg-secundario/10 blur-3xl"
  ></div>

  <div
    class="relative bg-white rounded-3xl shadow-[0_8px_30px_0_rgba(0,0,0,0.08)] max-w-xl w-full p-10 md:p-14 flex flex-col items-center text-center"
  >
    <div
      class="w-24 h-24 rounded-full bg-secundario/20 flex items-center justify-center mb-8"
    >
      <svg
        class="w-12 h-12 text-secundario"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M5 13l4 4L19 7"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>

    <h1 class="font-bold text-3xl md:text-4xl text-texto">
      {t("emailConfirmed.title")}
    </h1>
    <p class="text-neutral-500 text-lg mt-4 leading-relaxed max-w-md">
      {t("emailConfirmed.message")}
    </p>

    <a
      href={lang === "en" ? "/en/" : "/"}
      title={t("emailConfirmed.home")}
      aria-label={t("emailConfirmed.home")}
      class="mt-6 text-principal font-semibold hover:underline"
    >
      {t("emailConfirmed.home")}
    </a>
  </div>
</section>
