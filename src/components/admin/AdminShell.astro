---
import "../../styles/global.css";

import "@fontsource/pretendard/400.css";
import "@fontsource/pretendard/500.css";
import "@fontsource/pretendard/600.css";
import "@fontsource/pretendard/700.css";

import { ADMIN_SECTIONS } from "../../lib/admin/sections";
import LogoutButton from "./LogoutButton";

interface Props {
  title: string;
  active?: string;
}

const { title, active } = Astro.props;
const session = Astro.locals.admin;

const sectionIcons: Record<string, string> = {
  usuarios: "users",
  mascotas: "pets",
  alertas: "alert",
  encontradas: "heart",
  historias: "file",
  grupos: "users2",
  publicaciones: "file",
  avisos: "bell",
  reportes: "flag",
  bloqueos: "block",
};

function getSectionIcon(iconKey: string): string {
  const icons: Record<string, string> = {
    users: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 12H9m6 0a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
    pets: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2c-1.104 0-2-0.896-2-2s0.896-2 2-2 2 0.896 2 2-0.896 2-2 2zm0 4c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3zm8-2c-1.104 0-2-0.896-2-2s0.896-2 2-2 2 0.896 2 2-0.896 2-2 2zm0 4c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3zM4 2c-1.104 0-2-0.896-2-2s0.896-2 2-2 2 0.896 2 2-0.896 2-2 2zm0 4c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3z"/></svg>',
    alert: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2m6-4a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
    heart: '<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
    file: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
    users2: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
    comment: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>',
    bell: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>',
    flag: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-7 7 7 7H12.5l-1-1H5a2 2 0 00-2 2zm9-13h2.5L12 7"/></svg>',
    block: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  };
  return icons[iconKey] || '';
}

const groups = ADMIN_SECTIONS.reduce<Record<string, typeof ADMIN_SECTIONS>>(
  (acc, section) => {
    (acc[section.group] ??= []).push(section);
    return acc;
  },
  {}
);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Private tool: never index it. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="shortcut icon" href="/favicon_16x16.png" />
    <title>{title} · Panel Lucky Tracker</title>
    <style>
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: rgba(33, 31, 30, 0.2); border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: rgba(33, 31, 30, 0.3); }
    </style>
  </head>
  <body class="min-h-screen bg-fondo text-texto">
    <div class="flex min-h-screen flex-col lg:flex-row">
      <!-- Sidebar Navigation -->
      <aside class="border-b border-texto/10 bg-white lg:border-b-0 lg:border-r lg:w-64">
        <div class="sticky top-0 p-4 lg:p-6">
          <a href="/admin" class="flex items-center gap-3 font-bold text-texto mb-6">
            <span class="text-2xl font-bold text-principal">L</span>
            <span class="hidden lg:inline">Lucky Tracker</span>
          </a>

          <nav class="space-y-1" aria-label="Secciones del panel">
            {
              Object.entries(groups).map(([group, sections]) => (
                <div class="mb-6">
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-texto/40 block px-3 mb-2">
                    {group}
                  </span>
                  <div class="space-y-1">
                    {sections.map((section) => {
                      const iconKey = sectionIcons[section.slug];
                      const iconSvg = getSectionIcon(iconKey);
                      return (
                        <a
                          href={`/admin/${section.slug}`}
                          aria-current={active === section.slug ? "page" : undefined}
                          class:list={[
                            "flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all duration-200",
                            active === section.slug
                              ? "bg-principal/15 text-principal font-semibold"
                              : "text-texto/70 hover:bg-texto/5 hover:text-texto",
                          ]}
                        >
                          <span class="flex-shrink-0" set:html={iconSvg} />
                          <span>{section.title}</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </nav>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 flex flex-col">
        <!-- Top Bar -->
        <header class="border-b border-texto/10 bg-white">
          <div class="flex items-center justify-between px-4 py-3 lg:px-8 lg:py-4">
            <h1 class="text-lg font-semibold text-texto">{title}</h1>
            <div class="flex items-center gap-4">
              <span class="text-xs text-texto/60">
                {session?.email ?? session?.role}
              </span>
              <LogoutButton client:load />
            </div>
          </div>
        </header>

        <!-- Content Area -->
        <main class="flex-1 px-4 py-6 lg:px-8 lg:py-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
