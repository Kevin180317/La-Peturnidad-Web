---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { ui } from "../../i18n/ui";

type Key = keyof (typeof ui)["es"];

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const closeLabel = lang === "en" ? "Close" : "Cerrar";

const steps: {
  titleKey: Key;
  descKey: Key;
  accent: "salmon" | "teal";
  screens: { src: string; captionKey: Key }[];
}[] = [
  {
    titleKey: "howto.step.dashboard.title",
    descKey: "howto.step.dashboard.desc",
    accent: "teal",
    screens: [
      { src: "/how-to-use/inicio-tab.jpeg", captionKey: "howto.caption.inicioTab" },
      { src: "/how-to-use/inicio-lista.jpeg", captionKey: "howto.caption.inicioLista" },
    ],
  },
  {
    titleKey: "howto.step.pets.title",
    descKey: "howto.step.pets.desc",
    accent: "teal",
    screens: [
      { src: "/how-to-use/inicio-mascota.jpeg", captionKey: "howto.caption.inicioMascota" },
      { src: "/how-to-use/mascota-form.jpeg", captionKey: "howto.caption.mascotaForm" },
      { src: "/how-to-use/mascota-ficha.jpeg", captionKey: "howto.caption.mascotaFicha" },
      { src: "/how-to-use/mascota-editar.jpeg", captionKey: "howto.caption.mascotaEditar" },
    ],
  },
  {
    titleKey: "howto.step.emergency.title",
    descKey: "howto.step.emergency.desc",
    accent: "salmon",
    screens: [
      { src: "/how-to-use/emergencia-grid.jpeg", captionKey: "howto.caption.emergenciaGrid" },
      { src: "/how-to-use/emergencia-perdidas.jpeg", captionKey: "howto.caption.emergenciaPerdidas" },
      { src: "/how-to-use/emergencia-alerta-confirm.jpeg", captionKey: "howto.caption.alertaConfirm" },
      { src: "/how-to-use/emergencia-push.jpeg", captionKey: "howto.caption.push" },
    ],
  },
  {
    titleKey: "howto.step.found.title",
    descKey: "howto.step.found.desc",
    accent: "salmon",
    screens: [
      { src: "/how-to-use/emergencia-encontrada-confirm.jpeg", captionKey: "howto.caption.encontradaConfirm" },
      { src: "/how-to-use/emergencia-encontradas.jpeg", captionKey: "howto.caption.encontradas" },
    ],
  },
  {
    titleKey: "howto.step.feed.title",
    descKey: "howto.step.feed.desc",
    accent: "teal",
    screens: [
      { src: "/how-to-use/feed-tab.jpeg", captionKey: "howto.caption.feedTab" },
      { src: "/how-to-use/feed-publicar.jpeg", captionKey: "howto.caption.feedPublicar" },
    ],
  },
  {
    titleKey: "howto.step.community.title",
    descKey: "howto.step.community.desc",
    accent: "teal",
    screens: [
      { src: "/how-to-use/comunidad-tab.jpeg", captionKey: "howto.caption.comunidadTab" },
    ],
  },
  {
    titleKey: "howto.step.profile.title",
    descKey: "howto.step.profile.desc",
    accent: "teal",
    screens: [
      { src: "/how-to-use/perfil-info.jpeg", captionKey: "howto.caption.perfilInfo" },
      { src: "/how-to-use/perfil-cuenta.jpeg", captionKey: "howto.caption.perfilCuenta" },
    ],
  },
];
---

<section id="steps" class="mx-auto px-6 pb-24 scroll-mt-24">
  <div class="flex flex-col gap-20 md:gap-28 max-w-[1100px] mx-auto pt-16">
    {
      steps.map((step, i) => (
        <article
          class={`flex flex-col ${
            i % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"
          } items-center gap-10 md:gap-14`}
        >
          <div class="md:w-1/2 w-full">
            <div class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_4px_24px_rgba(33,31,30,0.08)] ring-1 ring-black/5">
              <span
                class={`inline-flex items-center justify-center w-11 h-11 rounded-full text-white font-bold text-lg mb-5 shadow-md ${
                  step.accent === "salmon" ? "bg-principal" : "bg-secundario"
                }`}
              >
                {i + 1}
              </span>
              <h2 class="text-2xl md:text-3xl font-bold text-texto leading-tight">
                {t(step.titleKey)}
              </h2>
              <p class="mt-4 text-neutral-500 leading-relaxed md:text-lg">
                {t(step.descKey)}
              </p>
            </div>
          </div>
          <div class="md:w-1/2 flex flex-wrap justify-center items-start gap-x-5 gap-y-8">
            {step.screens.map((s) => (
              <figure
                class="group flex flex-col items-center gap-3 w-[170px] sm:w-[200px] shrink-0 cursor-zoom-in"
                data-full={s.src}
                data-caption={t(s.captionKey)}
                role="button"
                tabindex="0"
              >
                <div class="relative rounded-[32px] bg-[#0d0d0d] px-[9px] pt-7 pb-[9px] shadow-[0_16px_40px_rgba(0,0,0,0.3)] ring-1 ring-black/10 w-full transition-transform duration-300 group-hover:-translate-y-1 group-hover:ring-principal/60">
                  <span class="absolute top-2.5 left-1/2 -translate-x-1/2 h-[5px] w-14 rounded-full bg-white/15" />
                  <img
                    src={s.src}
                    alt={t(s.captionKey)}
                    loading="lazy"
                    class="rounded-[22px] w-full block bg-white"
                  />
                </div>
                <figcaption class="text-xs text-neutral-500 text-center leading-snug max-w-[190px]">
                  {t(s.captionKey)}
                </figcaption>
              </figure>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <div
    id="lightbox"
    class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/85 p-4 md:p-8"
    role="dialog"
    aria-modal="true"
  >
    <button
      id="lightbox-close"
      type="button"
      aria-label={closeLabel}
      class="absolute top-5 right-5 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 hover:rotate-90 duration-200"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="h-6 w-6"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <figure class="flex max-h-full flex-col items-center gap-3">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[82vh] max-w-[90vw] rounded-2xl bg-white object-contain shadow-2xl"
      />
      <figcaption id="lightbox-caption" class="text-sm text-white/75 text-center" />
    </figure>
  </div>
</section>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxCaption = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");

  function openLightbox(src: string, caption: string) {
    if (!lightbox || !lightboxImg || !lightboxCaption) return;
    lightboxImg.src = src;
    lightboxImg.alt = caption;
    lightboxCaption.textContent = caption;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document
    .querySelectorAll<HTMLElement>("#steps figure[data-full]")
    .forEach((fig) => {
      fig.addEventListener("click", () =>
        openLightbox(fig.dataset.full ?? "", fig.dataset.caption ?? "")
      );
      fig.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        e.preventDefault();
        openLightbox(fig.dataset.full ?? "", fig.dataset.caption ?? "");
      });
    });

  closeBtn?.addEventListener("click", closeLightbox);

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      lightbox &&
      !lightbox.classList.contains("hidden")
    ) {
      closeLightbox();
    }
  });
</script>
