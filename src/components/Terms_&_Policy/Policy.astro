---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { policyContent } from "../../i18n/legal";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const content = policyContent[lang] ?? policyContent.es;
---

<section class="pt-20">
  <div
    class="bg-[url('/PlainBanner.png')] bg-cover bg-center bg-no-repeat h-[250px] md:h-[300px] w-full flex items-center justify-center"
  >
    <div class="flex items-center justify-center max-w-[750px] w-full px-4">
      <h1 class="font-bold text-3xl md:text-5xl text-white text-center">
        {t("policy.title")}
      </h1>
    </div>
  </div>
  <div>
    <div
      class="max-w-[1200px] mx-auto px-6 flex flex-col justify-center pb-10 mt-10 lg:mt-24 space-y-8"
    >
      <p class="text-sm md:text-base text-texto/70">{content.updated}</p>
      {
        content.sections.map((section) => (
          <div>
            <h2
              id={section.id}
              class="scroll-mt-24 text-2xl font-semibold mb-2 text-principal"
            >
              {section.title}
            </h2>
            <div class="space-y-3">
              {section.blocks.map((block) =>
                block.type === "p" ? (
                  <p class="text-texto leading-relaxed" set:html={block.html} />
                ) : block.type === "ul" ? (
                  <ul class="list-disc pl-6 space-y-2 text-texto leading-relaxed">
                    {block.items.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                ) : (
                  <div class="overflow-x-auto">
                    <table class="min-w-full border-collapse text-sm md:text-base text-texto leading-relaxed">
                      <thead>
                        <tr class="border-b-2 border-gray-200 text-left">
                          {block.head.map((cell) => (
                            <th
                              class="py-2 pr-4 align-top font-semibold text-principal"
                              set:html={cell}
                            />
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr class="border-b border-gray-200">
                            {row.map((cell) => (
                              <td class="py-3 pr-4 align-top" set:html={cell} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
