---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="w-screen lg:h-[700px] bg-[url('/FrontPageHeroMobile.png')] sm:bg-[url('/FrontpageHero.png')] bg-cover bg-[position:70%_50%] lg:bg-center bg-no-repeat"
>
  <div
    class="h-[400px] lg:h-[700px] w-full flex items-center justify-center mt-20 px-6"
  >
    <div
      class="max-w-[1200px] mx-auto flex flex-col gap-4 w-full items-start lg:justify-center h-[400px] lg:h-[700px]"
    >
      <h1
        class="font-bold text-2xl md:text-4xl lg:text-6xl text-texto max-w-xs md:max-w-md lg:max-w-2xl leading-relaxed pt-5 lg:pt-0"
      >
        {t("home.hero.h1")}
      </h1>
      <p
        class="font-normal text-xs md:text-lg lg:text-2xl text-texto max-w-3xs md:max-w-sm lg:max-w-xl leading-relaxed"
      >
        {t("home.hero.h2")}
      </p>
      <div class="flex flex-col gap-4 items-start">
        <span
          class="inline-flex items-center justify-center bg-principal text-white font-bold text-lg lg:text-2xl px-6 py-3 rounded-full shadow-xl"
        >
          {t("home.hero.comingSoon")}
        </span>
        <a
          class="inline-flex items-center justify-center bg-white rounded-lg py-2 px-4 border-0 shadow font-bold text-xs lg:text-base text-texto hover:text-principal"
          href={lang === "en" ? "/en/about" : "/about"}
          title="About Lucky Tracker"
          aria-label="Learn more about Lucky Tracker"
        >
          {t("home.hero.learnMore")}
        </a>
      </div>
    </div>
  </div>
</section>
